# Copier ce fichier en `.env` et remplacer les valeurs par les vraies.
# Chaîne de connexion PostgreSQL (PostgreSQL >= 15 requis).
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
# Secret servant à signer les JWT (longue chaîne aléatoire).
JWT_SECRET="change-me-with-a-long-random-string"