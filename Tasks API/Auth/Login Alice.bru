meta {
  name: Login Alice
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {"email": "alice@example.com", "password": "Password123!"}
}

vars:post-response {
  tokenAlice: res.body.access_token
}

tests {
  test("login réussi", function () { expect(res.status).to.be.oneOf([200, 201]); });
  test("access_token présent", function () { expect(res.body.access_token).to.be.a("string"); });
}

script:post-response {
  bru.runner.setNextRequest("Login Bob");
}

