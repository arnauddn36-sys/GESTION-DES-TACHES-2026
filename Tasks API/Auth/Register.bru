meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {"name": "Nouvel Utilisateur", "email": "{{newEmail}}", "password": "Password123!"}
}

script:pre-request {
  bru.setVar("newEmail", "user" + Date.now() + "@example.com");
}

tests {
  test("statut 201", function () { expect(res.status).to.equal(201); });
  test("le mot de passe n'est jamais renvoyé", function () { expect(res.body).to.not.have.property("password"); });
}

script:post-response {
  bru.runner.setNextRequest("Register duplicate email");
}

