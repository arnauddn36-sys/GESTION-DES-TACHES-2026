meta {
  name: Register duplicate email
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {"name": "Alice", "email": "alice@example.com", "password": "Password123!"}
}

tests {
